<Window x:Class="AshaLive.TemporarySessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary ASHA session"
        Width="445"
        Height="255"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Border Margin="10"
            Padding="24"
            CornerRadius="25"
            Background="#F4FBFFFF"
            BorderBrush="#B7D9F5"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.25" Color="#173E70" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#12355E"
                       Text="Keep this temporary session?" />
            <StackPanel Grid.Row="1" Margin="0,12,0,16">
                <TextBlock FontSize="13"
                           Foreground="#526A84"
                           TextWrapping="Wrap"
                           Text="This session is not in your retained history. Keep it to save its conversation and timeline, or discard it permanently." />
                <TextBlock Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="#71869B"
                           TextWrapping="Wrap"
                           Text="Cancel returns to ASHA without ending or switching the session." />
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Padding="12,7"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Content="Cancel" />
                <Button Padding="12,7"
                        Margin="0,0,8,0"
                        Click="Discard_Click"
                        Content="Discard" />
                <Button Padding="13,7"
                        Background="#1D64B8"
                        BorderBrush="#1D64B8"
                        Foreground="White"
                        Click="Keep_Click"
                        Content="Keep session" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
