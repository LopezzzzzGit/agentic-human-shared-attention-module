<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>asha-live</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="..\uia-worker\AshaUiaWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="BuildAndCopyUiaWorker" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_UiaWorkerArtifacts Include="$(MSBuildProjectDirectory)\..\uia-worker\bin\$(Configuration)\net8.0-windows10.0.26100.0\asha-uia-worker.*" />
      <_UiaWorkerArtifacts Include="$(TargetDir)asha-uia-worker.*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)uia-worker" />
    <Copy SourceFiles="@(_UiaWorkerArtifacts)" DestinationFolder="$(TargetDir)uia-worker" SkipUnchangedFiles="true" />
  </Target>

  <!-- Keep WPF's Point, Brush, and TextBox unambiguous. The tray API is
       referenced explicitly with aliases in MainWindow.xaml.cs. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
