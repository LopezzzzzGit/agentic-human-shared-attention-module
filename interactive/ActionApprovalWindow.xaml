<Window x:Class="AshaLive.ActionApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASHA approval"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Border Padding="18"
            CornerRadius="22"
            Background="#F7FBFFFF"
            BorderBrush="#94BFFF"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.24" Color="#183A69" />
        </Border.Effect>
        <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#173F70"
                       Text="ASHA needs your approval" />
            <TextBlock Margin="0,7,0,0"
                       FontSize="12"
                       Foreground="#4D6680"
                       TextWrapping="Wrap"
                       Text="Background interaction was unavailable. ASHA is asking to use your physical pointer for one exact action." />
            <Border Margin="0,14,0,0"
                    Padding="12"
                    CornerRadius="13"
                    Background="#EAF4FFFF"
                    BorderBrush="#CADFF5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#476988"
                               Text="PROPOSED ACTION" />
                    <TextBlock x:Name="SummaryText"
                               Margin="0,5,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#173F70"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ExpiryText"
                       Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="#6A7F94" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="10"
                       Foreground="#6A7F94"
                       TextWrapping="Wrap"
                       Text="Approval is one-time. It does not change your saved settings or approve another target." />
            <TextBlock Margin="0,4,0,0"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#476988"
                       TextWrapping="Wrap"
                       Text="Press Ctrl+Alt+Escape at any time to stop computer control." />
            <StackPanel Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Padding="14,7"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Content="Cancel" />
                <Button Padding="15,7"
                        Click="Approve_Click"
                        Background="#3478E5"
                        Foreground="White"
                        BorderBrush="#3478E5"
                        Content="Approve once" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
